    "checks": [
    {
    "code": "CUS001",
    "description": "Custom check to ensure 'environment' label is applied to all GCP instances",
    "impact": "Missing labels make cost tracking and resource management difficult.",
    "resolution": "Add the 'environment' label to the resource.",
    "requiredTypes": [
    "resource"
    ],
    "requiredLabels": [
    "google_compute_instance"
    ],
    "severity": "ERROR",
    "matchSpec": {
    "name": "labels",
    "action": "contains",
    "value": "environment"
    },
    "errorMessage": "The 'environment' label is missing from the compute instance."
    }
    ]
    package custom.gcp.compute.enforce_env_label

    # This rule identifies any google_compute_instance that
    # doesn't have a valid 'environment' label.
    deny[msg] {
    # Iterate through all compute instances
    instance := input.google.compute.instances[_]

    # Check if 'environment' label is missing or has an invalid value
    valid_envs := {"prod", "staging", "dev"}
    env_val := instance.labels.value["environment"]

    not valid_envs[env_val]

    msg := sprintf("Instance '%s' must have an 'environment' label set to one of: prod, staging, dev", [instance.name.value])
    }
    package user.gcp.storage.enforce_bucket_versioning

    import data.lib.result

    # METADATA
    # title: Enforce versioning on GCS buckets
    # description: Bucket versioning should be enabled to protect against accidental deletion or modification of data.
    # scope: package
    # schemas:
    #   - input: schema["cloud"]
    # custom:
    #   id: CUS003
    #   severity: MEDIUM
    #   input:
    #     selector:
    #       - type: cloud
    #         subtypes:
    #           - service: storage
    #             provider: gcp

    deny[res] {
    bucket := input.gcp.storage.buckets[_]

    # Check if versioning is disabled or not set
    not bucket.versioning.enabled.value

    res := result.new(
    sprintf("Bucket '%s' does not have versioning enabled.", [bucket.name.value]),
    bucket.versioning.enabled,
    )
    }
