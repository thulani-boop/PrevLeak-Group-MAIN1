    package user.gcp.storage.enforce_bucket_cmek

    import data.lib.result

    # METADATA
    # title: Enforce Customer-Managed Encryption Keys (CMEK) on GCS buckets
    # description: GCS buckets should be encrypted using a Customer-Managed Encryption Key (CMEK) to ensure full control over data encryption.
    # scope: package
    # schemas:
    #   - input: schema["cloud"]
    # custom:
    #   id: CUS006
    #   severity: HIGH
    #   input:
    #     selector:
    #       - type: cloud
    #         subtypes:
    #           - service: storage
    #             provider: gcp

    deny[res] {
    bucket := input.gcp.storage.buckets[_]

    # Check if a KMS key name is provided
    not bucket.encryption.kms_key_name.value

    res := result.new(
    sprintf("Bucket '%s' is not encrypted with a Customer-Managed Encryption Key (CMEK).", [bucket.name.value]),
    bucket.encryption.kms_key_name,
    )
    }

