import data.lib.result

# METADATA
# title: Enforce versioning on GCS buckets
# description: Bucket versioning should be enabled to protect against accidental deletion or modification of data.
# scope: package
# schemas:
#   - input: schema["cloud"]
# custom:
#   id: CUS003
#   severity: MEDIUM
#   input:
#     selector:
#       - type: cloud
#         subtypes:
#           - service: storage
#             provider: gcp

deny[res] {
    bucket := input.gcp.storage.buckets[_]

    # Check if versioning is disabled or not set
    not bucket.versioning.enabled.value

    res := result.new(
        sprintf("Bucket '%s' does not have versioning enabled.", [bucket.name.value]),
        bucket.versioning.enabled,
    )
}
